#!/bin/sh
# Kill everything the service left in its process group before the next run.
kill -KILL -"$4" 2>/dev/null || :
while kill -0 -"$4" 2>/dev/null; do
    /command/s6-sleep -m 10
done
rm -f /run/counter-value
# A trial candidate must stay down so a crash cannot restart into success.
[ -e /run/mutator/trial ] && exit 125
exit 0
